default:
    just --list

# manifest sync: machine → source, for every dumpable package manifest.
# Brewfile (brew bundle dump) + mise.toml (explicit re-add — bare re-add would
# sweep in unrelated age churn). Packages.pacman/.aur are NOT here: they are
# source-curated manifests with comments a target dump would destroy.
[group('manifests')]
dump:
    #!/usr/bin/env sh
    set -u
    if command -v brew >/dev/null 2>&1; then
      brew bundle dump --force --file="$HOME/.config/homebrew/Brewfile" && \
        chezmoi re-add "$HOME/.config/homebrew/Brewfile" && echo "✓ Brewfile re-added"
    else
      echo "· brew not found — skipping Brewfile"
    fi
    if command -v mise >/dev/null 2>&1; then
      chezmoi re-add "$HOME/.config/mise/mise.toml" && echo "✓ mise.toml re-added"
    else
      echo "· mise not found — skipping mise.toml"
    fi
    echo "--- captured (chezmoi source git status) ---"
    git -C "$(chezmoi source-path)" status --short || true

[group('chezmoi')]
diff:
    chezmoi diff

[group('chezmoi')]
apply:
    chezmoi apply

[group('chezmoi')]
apply-refresh-externals:
    chezmoi apply --refresh-externals

[group('chezmoi')]
update:
    chezmoi update

[group('chezmoi')]
re-add:
    chezmoi re-add

[group('chezmoi')]
merge-all:
	chezmoi merge-all

[group('chezmoi')]
cd:
	chezmoi cd

[group('chezmoi')]
init:
	chezmoi init

# 仓库的可执行检查面（the repo's check surface）：ssh-agent 运行 + key 已加载（bw-ssh-add）+ GitHub
# 能用 key 认证 + externals 已 clone（从 .chezmoiexternals/ 推导）+ pinned tool 克隆存在
# （从 .chezmoidata.yaml 的 clonePath 推导）+ environment intake 就绪。
# 退出码非 0 表示有检查未通过（可用于 apply 后自检 / CI gate）。
[group('verify')]
doctor:
	#!/usr/bin/env sh
	set -u
	ok=0
	FAILS="$(mktemp)"
	trap 'rm -f "$FAILS"' EXIT
	pass() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
	# NOTE: fail() appends to a file, not a variable — several checks below run in
	# pipeline subshells (awk | while), where setting ok=1 would be lost.
	fail() { printf '  \033[31m✗\033[0m %s\n' "$1"; echo "$1" >>"$FAILS"; }
	hdr() { printf '\n== %s ==\n' "$1"; }

	hdr "ssh-agent"
	if command -v ssh-add >/dev/null 2>&1; then
	  pass "ssh-add on PATH"
	  if [ -n "${SSH_AUTH_SOCK:-}" ]; then
	    pass "SSH_AUTH_SOCK set ($SSH_AUTH_SOCK)"
	  else
	    fail "SSH_AUTH_SOCK unset (run from a login shell, or check ~/.zprofile)"
	  fi
	  if ssh-add -l >/dev/null 2>&1; then
	    pass "agent has an identity (re-run 'bw-ssh-add' to refresh)"
	  else
	    fail "agent empty (run: bw-ssh-add)"
	  fi
	else
	  fail "ssh-add NOT on PATH"
	fi

	hdr "github ssh key"
	if ssh -T -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new git@github.com 2>&1 | grep -q 'Hi '; then
	  pass "served key authenticates to GitHub"
	else
	  fail "GitHub SSH auth failed (key not served / vault locked)"
	fi

	hdr "externals"
	# Derived from .chezmoiexternals/ — new externals are checked automatically.
	# git-repo targets need a .git dir; type: file targets need the file to exist.
	# Top-level keys are home-relative paths in this repo; commented-out entries
	# (leading #) don't match the key regex.
	EXT_DIR="$(chezmoi source-path .chezmoiexternals 2>/dev/null || \
	  printf '%s/.local/share/chezmoi/.chezmoiexternals' "$HOME")"
	for f in "$EXT_DIR"/*.yaml "$EXT_DIR"/*.yaml.tmpl; do
	  [ -f "$f" ] || continue
	  awk '
	    /^[A-Za-z0-9._~\/:-]+:$/ { path=$0; sub(/:$/, "", path) }
	    /^[ \t]+type:[ \t]*/ { ty=$0; sub(/^[ \t]+type:[ \t]*/, "", ty); print path "\t" ty }
	  ' "$f"
	done | while IFS="$(printf '\t')" read -r p ty; do
	  [ -n "$p" ] || continue
	  case "$ty" in
	    git-repo)
	      if [ -d "$HOME/$p/.git" ]; then pass "cloned: $p"; else fail "missing: $p (chezmoi apply --refresh-externals)"; fi
	      ;;
	    file)
	      if [ -f "$HOME/$p" ]; then pass "file: $p"; else fail "missing: $p (chezmoi apply --refresh-externals)"; fi
	      ;;
	  esac
	done

	hdr "pinned tools"
	# Pinned-tool installers own their clones (no .chezmoiexternals entry — a
	# tag-pinned external's refresh aborts apply on detached HEAD). Derived from
	# clonePath entries in .chezmoidata.yaml: top-level keys are <tool>, nested
	# ones are <group>.<tool>. Adding a clonePath updates this check automatically.
	DATA_YAML="$(chezmoi source-path .chezmoidata.yaml 2>/dev/null || \
	  printf '%s/.local/share/chezmoi/.chezmoidata.yaml' "$HOME")"
	awk '
	  /^[A-Za-z0-9_.-]+:[ \t]*$/ { top=$0; sub(/:.*/, "", top); mid="" }
	  /^  [A-Za-z0-9_.-]+:[ \t]*$/ { mid=$0; sub(/^  /, "", mid); sub(/:.*/, "", mid); mid=top "." mid }
	  /^[ \t]+clonePath:/ {
	    path=$0; sub(/^[ \t]*clonePath:[ \t]*/, "", path)
	    name=(mid == "" ? top : mid)
	    print name "\t" path
	  }
	' "$DATA_YAML" | while IFS="$(printf '\t')" read -r name p; do
	  [ -n "$p" ] || continue
	  if [ -d "$HOME/$p/.git" ]; then pass "pinned: $name ($p)"; else fail "pinned: $name clone missing: $p (chezmoi apply)"; fi
	done

	hdr "environment intake"
	# Every env.d entry in source (plain + encrypted) must exist on target, and
	# the glob loop must actually run in the login-shell shape launchd/systemd
	# spawns (sentinel: RCLONE_FILTER_FROM set AND its target file present).
	ENV_SRC="$(chezmoi source-path dot_config/zsh/env.d 2>/dev/null || \
	  printf '%s/.local/share/chezmoi/dot_config/zsh/env.d' "$HOME")"
	for f in "$ENV_SRC"/*; do
	  [ -f "$f" ] || continue
	  b="$(basename "$f")"
	  case "$b" in encrypted_private_*) b="${b#encrypted_private_}"; b="${b%.age}" ;; esac
	  if [ -f "$HOME/.config/zsh/env.d/$b" ]; then pass "intake: $b"; else fail "intake: $b missing (chezmoi apply)"; fi
	done
	val="$(zsh -lc 'printf %s "${RCLONE_FILTER_FROM:-}"' 2>/dev/null)"
	if [ -n "$val" ] && [ -f "$val" ]; then
	  pass "intake glob loads in login shell ($val)"
	else
	  fail "intake sentinel failed (zsh -lc RCLONE_FILTER_FROM)"
	fi

	if [ -s "$FAILS" ]; then
	  exit 1
	fi

