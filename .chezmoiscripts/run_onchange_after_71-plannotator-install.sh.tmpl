#!/usr/bin/env bash
# Manage plannotator (https://github.com/backnotprop/plannotator) via chezmoi —
# pinned-tool installer. This script OWNS the clone at plugins.plannotator.clonePath
# (.chezmoidata.yaml); there is no .chezmoiexternals entry for it. Externals are for
# HEAD-tracking clones; a tag-pinned external with periodic refresh aborts apply on
# detached HEAD. See docs/superpowers/specs/2026-08-21-pinned-tool-installer-design.md
#
# Registers plannotator as a Claude Code plugin via a directory-source marketplace
# (pinned to the ref below) AND installs the binary layer via upstream install.sh.
#
# Error philosophy (aligned with 70-ecc):
#   LOUD clone    — clone/fetch/checkout failures exit 1, so chezmoi does NOT
#                   record the script's hash and retries on the next apply. (This
#                   replaces the old exit-0 + `chezmoi state delete` recovery dance:
#                   a failing script is never hash-recorded, so retry is automatic.)
#   TOLERANT tail — registration/binary-install steps warn and continue.
# Re-runs whenever plugins.plannotator.version changes (version is embedded in the
# comment below, so bumping it in .chezmoidata.yaml changes this script's content
# hash and retriggers run_onchange). Idempotent.
# version={{ .plugins.plannotator.version }}
{{- $plnClone := joinPath (joinPath .chezmoi.homeDir .plugins.plannotator.clonePath) ".git" }}
# clone-present={{ if stat $plnClone }}yes{{ else }}no{{ end }}
#
# No `set -e`: this is a chezmoi lifecycle script and must tolerate partial failure
# (missing mise tools, network errors) without blocking `chezmoi apply` — except the
# LOUD clone section above, which deliberately exits 1 for retry.

PLN_SRC="$HOME/{{ .plugins.plannotator.clonePath }}"
PLN_VERSION="{{ .plugins.plannotator.version }}"
PLN_REF="{{ .plugins.plannotator.ref }}"
PLN_SKIP_SEM="{{ .plugins.plannotator.skipSem }}"
INSTALL_DIR="$HOME/.local/bin"

# Tooling is mise-managed on this machine. Skip gracefully if absent — the plugin
# registration and binary install both need node/bun/claude.
for tool in node bun claude; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "[plannotator] $tool not found on PATH — skipping install." >&2
    exit 0
  }
done

# --- LOUD: own the clone at the pinned ref ------------------------------------------
if [ ! -d "$PLN_SRC/.git" ]; then
  if ! git clone --quiet --branch "$PLN_REF" https://github.com/backnotprop/plannotator.git "$PLN_SRC"; then
    echo "[plannotator] clone failed — exiting 1 so chezmoi retries on the next apply." >&2
    exit 1
  fi
fi

cd "$PLN_SRC" || exit 1
if ! git fetch --tags --quiet || ! git checkout --quiet --force "$PLN_REF"; then
  echo "[plannotator] pin to $PLN_REF failed — exiting 1 so chezmoi retries on the next apply." >&2
  exit 1
fi

# --- TOLERANT: everything downstream warns and continues -----------------------------

# Register as a directory-source plugin so the pin sticks (a github-source marketplace
# would track upstream HEAD). remove-then-add handles the github->directory source-type
# change idempotently.
claude plugin marketplace remove plannotator >/dev/null 2>&1 || true
claude plugin marketplace add "$PLN_SRC" --scope user ||
  echo "[plannotator] marketplace add failed — continuing" >&2
claude plugin install plannotator@plannotator --scope user ||
  echo "[plannotator] plugin install failed — continuing" >&2

# Binary layer: install.sh always re-downloads (it rm's the binary first), so gate
# the call on the installed version to keep re-runs cheap and offline-safe.
NEEDS_BINARY=1
if [ -x "$INSTALL_DIR/plannotator" ]; then
  CURRENT="$("$INSTALL_DIR/plannotator" --version 2>/dev/null | awk '{print $2}')"
  if [ "$CURRENT" = "$PLN_VERSION" ]; then
    NEEDS_BINARY=0
  fi
fi

if [ "$NEEDS_BINARY" = "1" ]; then
  echo "[plannotator] installing binary layer v$PLN_VERSION via upstream install.sh"
  if [ "$PLN_SKIP_SEM" = "true" ]; then
    export PLANNOTATOR_SKIP_SEM_INSTALL=1
  fi
  if ! timeout 300 bash "$PLN_SRC/scripts/install.sh" \
      --version "$PLN_VERSION" \
      --non-interactive \
      --no-extras \
      --model-invocable none \
      --skip-attestation; then
    echo "[plannotator] install.sh failed (timeout or error) — binary layer not installed, continuing." >&2
  fi
else
  echo "[plannotator] binary layer already at v$PLN_VERSION, skipping install.sh"
fi

echo "[plannotator] done (ref=$PLN_REF, version=$PLN_VERSION)"
exit 0
